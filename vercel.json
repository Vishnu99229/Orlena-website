{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://orlena.talk/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "hello.orlena.talk"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
